{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Erp": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "myErp",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00"
  },
  "Auth": {
    "RefreshTokenLifetime": "7.00:00:00",
    "RefreshReuseGrace": "00:01:00",
    "LockoutAttempts": 3,
    "LockoutDuration": "00:15:00",
    "SessionCheckCache": "00:00:30"
  },
  "Drafts": {
    "MaxDataLength": 200000
  },
  "Email": {
    "FromAddress": "no-reply@myerp.local",
    "FromName": "myErp",
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "PickupDirectory": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "RateLimiting": {
    "LoginPerMinute": 10
  },
  "AllowedHosts": "*"
}
