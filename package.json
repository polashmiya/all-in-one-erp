{
  "name": "myerp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:panel": "pnpm --filter @erp/panel-web dev",
    "dev:erp": "pnpm --filter @erp/erp-web dev",
    "dev:api": "dotnet run --project backend/src/Erp.Api --launch-profile http",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:api": "dotnet build backend/Erp.sln",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "pnpm --filter @erp/api-client gen",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "vitest run",
    "test:api": "dotnet test backend/Erp.sln",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pnpm": "10.34.9",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
